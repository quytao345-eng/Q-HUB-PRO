        return nil
    end

    local function SetTargetMode(mode, fromDropdown)
        mode = NormalizeMode(mode)
        if not mode then return end
        local prev = targetPositionMode
        targetPositionMode = mode
        pcall(function() ModeTargetBtn.Text = mode end)
        -- Rời Top → tắt Physics/gravity lock
        if prev == "Top" and mode ~= "Top" then
            RestoreGravity()
        end
        if fromDropdown then return end
        if syncingMode then return end
        if ModeDropdownObj then
            syncingMode = true
            pcall(function()
                if ModeDropdownObj.Select then
                    ModeDropdownObj:Select(mode)
                elseif ModeDropdownObj.Set then
                    ModeDropdownObj:Set(mode)
                end
            end)
            task.defer(function()
                task.wait(0.05)
                syncingMode = false
            end)
        end
    end

    ModeTargetBtn.MouseButton1Click:Connect(function()

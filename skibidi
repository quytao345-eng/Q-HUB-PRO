    local function UpdateBehindDistance(val, fromMobile)
        local num = tonumber(val)
        if not (num and num >= 0) then
            if NumTargetBox then NumTargetBox.Text = tostring(behindDistance) end
            return
        end
        behindDistance = num
        syncingNum = true
        if NumTargetBox and NumTargetBox.Text ~= tostring(num) then
            NumTargetBox.Text = tostring(num)
        end
        if not fromMobile and BehindDistInputObj and BehindDistInputObj.Set then
            pcall(function() BehindDistInputObj:Set(tostring(num)) end)
        end
        if fromMobile and BehindDistInputObj and BehindDistInputObj.Set then
            pcall(function() BehindDistInputObj:Set(tostring(num)) end)
        end
        syncingNum = false
    end

    NumTargetBox.FocusLost:Connect(function()
        UpdateBehindDistance(NumTargetBox.Text, true)
    end)
    NumTargetBox:GetPropertyChangedSignal("Text"):Connect(function()
        if syncingNum then return end
        local num = tonumber(NumTargetBox.Text)
        if num and num >= 0 then
            behindDistance = num
            if BehindDistInputObj and BehindDistInputObj.Set then
                syncingNum = true
                pcall(function() BehindDistInputObj:Set(tostring(num)) end)
                syncingNum = false
            end
        end
    end)

    local function StopTargeting()
        -- Cắt connection trước, xóa target sau → thoát chắc
        StopT("Behind")
        SelectedTargetPlayer = nil
        ResetCamToSelf()
        -- Thả velocity để không bị kéo tiếp
        pcall(function()
            local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
        end)
    end

    local targetSmooth = 0.35

    local function SetMobileTargetUI(on)
        TargetToggleBtn.Text = on and "ON" or "OFF"
        TargetToggleBtn.BackgroundColor3 = on and Color3.fromRGB(30, 220, 30) or Color3.fromRGB(220, 30, 30)
    end

    local function SyncAllTargetUI(on)
        if syncingTargetUI then return end
        syncingTargetUI = true
        SetMobileTargetUI(on)
        if ToggleTargetUIObj and ToggleTargetUIObj.Set then
            pcall(function() ToggleTargetUIObj:Set(on) end)
        end
        syncingTargetUI = false
    end

    local function StartTargetingPlayer(plr, forceEnable)
        if not plr or plr == LP then return end
        SelectedTargetPlayer = plr

        if forceEnable then
            targetModeEnabled = true
            SyncAllTargetUI(true)
        end
        if not targetModeEnabled then
            return
        end

        StopT("Behind")
        T.Behind = RS.Heartbeat:Connect(function(dt)
            -- Thoát ngay nếu đã tắt
            if not targetModeEnabled then
                StopT("Behind")
                return
            end

            local char = LP.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local tPlr = SelectedTargetPlayer
            local tChar = tPlr and tPlr.Character
            local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
            local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")

            if not tPlr or not tChar or not tHrp or not tHum or tHum.Health <= 0 then
                targetModeEnabled = false
                StopTargeting()
                SyncAllTargetUI(false)
                return
            end

            if hrp and tHrp then
                local dist = math.max(0, behindDistance)
                local goalCF
                if targetPositionMode == "Behind" then
                    goalCF = tHrp.CFrame * CFrame.new(0, 0, dist)
                elseif targetPositionMode == "Front" then
                    goalCF = tHrp.CFrame * CFrame.new(0, 0, -dist)
                    goalCF = CFrame.new(goalCF.Position, tHrp.Position)
                elseif targetPositionMode == "Top" then
                    goalCF = CFrame.new(tHrp.Position + Vector3.new(0, dist, 0), tHrp.Position)
                else
                    goalCF = tHrp.CFrame * CFrame.new(0, 0, dist)
                end

                local alpha = math.clamp(targetSmooth + (dt or 0.016) * 8, 0.15, 1)
                hrp.CFrame = hrp.CFrame:Lerp(goalCF, alpha)
                local vel = hrp.AssemblyLinearVelocity
                hrp.AssemblyLinearVelocity = Vector3.new(vel.X * 0.3, vel.Y * 0.5, vel.Z * 0.3)
            end
        end)
    end

    local function SetTargetMode(mode)
        targetPositionMode = mode
        ModeTargetBtn.Text = mode
        if ModeDropdownObj and ModeDropdownObj.Select then

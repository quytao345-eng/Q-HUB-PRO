    local function UpdateESPStates()
        for plr, data in pairs(ESPData) do
            if data.hl then data.hl.Enabled = espHighlight end
            if data.bb then data.bb.Enabled = (espName or espDistance) end
            if data.boxBb then data.boxBb.Enabled = espBox end

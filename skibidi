-- HELPER FUNCTIONS
local function StopT(n)
    if T[n] then
        if typeof(T[n]) == "RBXScriptConnection" then T[n]:Disconnect() else task.cancel(T[n]) end
        T[n] = nil
    end
end

local function ResetCamToSelf()
    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if hum and Cam then Cam.CameraSubject = hum end
end

local function GetNearestPlayer(maxDist)
    maxDist = maxDist or 500
    local closest, shortestDist = nil, maxDist
    local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil end
    for _, p in ipairs(P:GetPlayers()) do
        if p ~= LP and p.Character then
            local pHrp, pHum = p.Character:FindFirstChild("HumanoidRootPart"), p.Character:FindFirstChildOfClass("Humanoid")
            if pHrp and pHum and pHum.Health > 0 then
                local dist = (pHrp.Position - myHrp.Position).Magnitude
                if dist < shortestDist then
                    shortestDist, closest = dist, p
                end
            end
        end
    end
    return closest
end

local function GetPlayerListNames()
    local names = {}
    for _, p in ipairs(P:GetPlayers()) do
        if p ~= LP then table.insert(names, p.Name) end
    end
    return #names > 0 and names or {"No players found"}
end

local function IsVisiblePart(targetPart, wallCheckEnabled)
    if not wallCheckEnabled or not targetPart then return true end
    local myChar = LP.Character
    if not myChar then return false end
    local ray = Ray.new(Cam.CFrame.Position, (targetPart.Position - Cam.CFrame.Position).Unit * 500)
    local hit = W:FindPartOnRayWithIgnoreList(ray, {myChar, targetPart.Parent})
    return hit == nil or hit:IsDescendantOf(targetPart.Parent)
end

local function GetClosestTargetInFOV(radius, wallCheck, teamCheck, specificPart)
    local closestPart, closestPlayer, shortestDistance = nil, nil, radius
    local mousePos = UIS:GetMouseLocation()

    for _, p in ipairs(P:GetPlayers()) do
        if p ~= LP and p.Character and not (teamCheck and p.Team == LP.Team) then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local part = specificPart and (p.Character:FindFirstChild(specificPart) or p.Character:FindFirstChild("HumanoidRootPart")) or p.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and part then
                local screenPos, onScreen = Cam:WorldToViewportPoint(part.Position)
                if onScreen then
                    local distFromMouse = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if distFromMouse < shortestDistance and IsVisiblePart(part, wallCheck) then
                        shortestDistance = distFromMouse
                        closestPart, closestPlayer = part, p
                    end
                end
            end
        end
    end
    return closestPart, closestPlayer
end


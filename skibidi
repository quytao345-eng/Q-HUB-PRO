        SelectedTargetPlayer = nil
        RestoreGravity()
        ResetCamToSelf()
    end

    local function StartTargetingPlayer(plr, forceEnable)
        if not plr or plr == LP then return end
        SelectedTargetPlayer = plr

        if forceEnable then
            targetModeEnabled = true
            SyncAllTargetUI(true)
        end
        if not targetModeEnabled then return end

        -- Dừng follow cũ
        pcall(function() RS:UnbindFromRenderStep("QHub_TargetFollow") end)
        if T.Behind then
            pcall(function()
                if typeof(T.Behind) == "RBXScriptConnection" then
                    T.Behind:Disconnect()
                elseif typeof(T.Behind) ~= "string" then
                    task.cancel(T.Behind)
                end
            end)
            T.Behind = nil
        end

        -- Set physics 1 lần (tránh rung khi ChangeState mỗi frame)
        pcall(function()
            local char = LP.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hum then
                hum.PlatformStand = true
                hum:ChangeState(Enum.HumanoidStateType.Physics)
            end
            if hrp then
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end
        end)

        UpdateTargetView()

        -- Tele liên tục mỗi 0.0001s · nhẹ · không rung
        T.Behind = task.spawn(function()
            local lastSpin = os.clock()
            while targetModeEnabled do
                local tPlr = SelectedTargetPlayer
                if not tPlr or not tPlr.Parent then
                    targetModeEnabled = false
                    SelectedTargetPlayer = nil
                    RestoreGravity()
                    ResetCamToSelf()
                    task.defer(function() SyncAllTargetUI(false) end)
                    break
                end

                local char = LP.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local tChar = tPlr.Character
                local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
                local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")

                if not hrp or not tHrp or not tHum or tHum.Health <= 0 then
                    targetModeEnabled = false
                    SelectedTargetPlayer = nil
                    RestoreGravity()
                    ResetCamToSelf()
                    task.defer(function() SyncAllTargetUI(false) end)
                    break
                end

                local dist = math.max(0.5, behindDistance or 6)
                local mode = targetPositionMode or "Top"
                local goalCF

                if mode == "Top" then
                    goalCF = CFrame.new(tHrp.Position + Vector3.new(0, dist, 0), tHrp.Position)
                elseif mode == "Under" then
                    goalCF = CFrame.new(tHrp.Position + Vector3.new(0, -dist, 0), tHrp.Position)
                elseif mode == "Spin" then
                    local now = os.clock()
                    local dt = math.clamp(now - lastSpin, 0, 0.05)
                    lastSpin = now
                    spinAngle = spinAngle + dt * spinSpeed
                    local ox = math.cos(spinAngle) * dist
                    local oz = math.sin(spinAngle) * dist
                    goalCF = CFrame.new(tHrp.Position + Vector3.new(ox, 0, oz), tHrp.Position)
                elseif mode == "Behind" then
                    goalCF = tHrp.CFrame * CFrame.new(0, 0, dist)
                else -- Front
                    local front = tHrp.CFrame * CFrame.new(0, 0, -dist)
                    goalCF = CFrame.new(front.Position, tHrp.Position)
                end

                -- Teleport + zero velocity (không ChangeState mỗi lần → hết rung)
                hrp.CFrame = goalCF
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero

                -- Auto view (Under/Spin) — chỉ set khi lệch
                if ShouldAutoView() and tHum and Cam.CameraSubject ~= tHum then
                    ViewTargetPlayer(tPlr)
                end

                task.wait(0.0001)
            end
        end)
    end


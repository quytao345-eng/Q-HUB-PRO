    local function IsVisiblePart(part, wallCheck)
        if not wallCheck or not part then return true end
        local origin = Cam.CFrame.Position
        local dir = part.Position - origin
        if dir.Magnitude < 1 then return true end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {LP.Character, part.Parent}
        local result = W:Raycast(origin, dir.Unit * math.min(dir.Magnitude, 500), params)
        return result == nil or (result.Instance and result.Instance:IsDescendantOf(part.Parent))
    end

    local function GetClosestTargetToMouseFOV(radius, wallCheck, teamCheck, specificPart)
        local closestPart, closestPlayer, shortest = nil, nil, radius
        local center = Vector2.new(Mouse.X, Mouse.Y + fixedPovOffset)
        for _, p in ipairs(P:GetPlayers()) do
            if p ~= LP and p.Character and not (teamCheck and p.Team == LP.Team) then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local part = specificPart and (p.Character:FindFirstChild(specificPart) or p.Character:FindFirstChild("HumanoidRootPart")) or p.Character:FindFirstChild("HumanoidRootPart")
                    if part then
                        local pos, on = Cam:WorldToViewportPoint(part.Position)
                        if on then
                            local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                            if d < shortest and IsVisiblePart(part, wallCheck) then
                                shortest = d
                                closestPart, closestPlayer = part, p
                            end
                        end
                    end
                end
            end
        end
        return closestPart, closestPlayer
    end

    local function ToggleTargetMode(state)
        local now = tick()
        if now - lastTargetToggleAt < 0.25 then return end
        lastTargetToggleAt = now
        if state == nil then state = not targetModeEnabled end
        if not state then
            targetModeEnabled = false
            StopTargeting()
            SyncAllTargetUI(false)
            return
        end
        targetModeEnabled = true
        SyncAllTargetUI(true)
        local _, plr = GetClosestTargetToMouseFOV(targetFOVRadius, targetWallCheck)
        if plr then
            StartTargetingPlayer(plr)
        else
            WindUI:Notify({Title = "Target", Content = "Chưa có target", Duration = 2})
        end
    end


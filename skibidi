    local function UpdateTracerLine(frame, from, to)
        local dx = to.X - from.X
        local dy = to.Y - from.Y
        local len = math.sqrt(dx * dx + dy * dy)
        if len < 1 then
            frame.Visible = false
            return
        end
        local midX = (from.X + to.X) / 2
        local midY = (from.Y + to.Y) / 2
        local angle = math.deg(math.atan2(dy, dx))
        frame.Position = UDim2.fromOffset(midX, midY)
        frame.Size = UDim2.fromOffset(len, 3) -- đậm 3px
        frame.Rotation = angle
        frame.Visible = true
    end


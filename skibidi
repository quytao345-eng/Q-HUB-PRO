RS.RenderStepped:Connect(function()
    if not cooldownTrackerEnabled then return end
    for _, p in ipairs(P:GetPlayers()) do
        if p ~= LP and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local gui = hrp and hrp:FindFirstChild("QHub_TrackerGui")
            local lbl = gui and gui:FindFirstChild("StatusLabel")
            if lbl then
                local isBlocking = p.Character:FindFirstChild("Blocking") or p.Character:FindFirstChild("Block")
                local isAttacking = p.Character:FindFirstChild("UsingSkill") or p.Character:FindFirstChild("Attacking")
                local ultVal = p:FindFirstChild("Awakening") or p:FindFirstChild("Ultimate")
                
                local ultText = ultVal and (tostring(ultVal.Value) .. "%") or "READY / UNKNOWN"
                local stateText = "NORMAL"
                if isBlocking then stateText = "🛡️ BLOCKING"
                elseif isAttacking then stateText = "⚔️ IN SKILL" end

                lbl.Text = "ULT: " .. ultText .. "\nSTATE: " .. stateText
                if isAttacking then
                    lbl.TextColor3 = Color3.fromRGB(255, 50, 50)
                elseif isBlocking then
                    lbl.TextColor3 = Color3.fromRGB(50, 150, 255)
                else
                    lbl.TextColor3 = Color3.fromRGB(255, 255, 0)
                end
            end
        end
    end
end)


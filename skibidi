local function CreateESP(plr)
	if plr == LP then return end
	local function SetupCharacter(char)
		if not char then return end
		local hrp = char:WaitForChild("HumanoidRootPart", 5)
		local hum = char:WaitForChild("Humanoid", 5)
		if not hrp or not hum then return end

		local hl = char:FindFirstChild("QHub_Highlight") or Instance.new("Highlight")
		hl.Name = "QHub_Highlight"
		hl.FillTransparency = 0.5
		hl.FillColor = Color3.fromRGB(255, 45, 85)
		hl.OutlineColor = Color3.fromRGB(255, 255, 255)
		hl.OutlineTransparency = 0
		hl.Enabled = espHighlight
		hl.Parent = char

		local bb = hrp:FindFirstChild("QHub_Billboard") or Instance.new("BillboardGui")
		bb.Name = "QHub_Billboard"
		bb.Size = UDim2.new(0, 200, 0, 50)
		bb.AlwaysOnTop = true
		bb.ExtentsOffset = Vector3.new(0, 3, 0)
		bb.Enabled = (espName or espHealth)
		bb.Parent = hrp

		local txtLabel = bb:FindFirstChild("TextLabel") or Instance.new("TextLabel", bb)
		txtLabel.Size = UDim2.new(1, 0, 1, 0)
		txtLabel.BackgroundTransparency = 1
		txtLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		txtLabel.TextSize = 14
		txtLabel.Font = Enum.Font.SourceSansBold
		txtLabel.TextStrokeTransparency = 0

		local function updateText()
			local t = ""
			if espName then t = t .. plr.Name end
			if espHealth then t = t .. " [" .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth) .. "]" end
			txtLabel.Text = t
		end

		hum.HealthChanged:Connect(updateText)
		updateText()
	end

	if plr.Character then SetupCharacter(plr.Character) end
	plr.CharacterAdded:Connect(SetupCharacter)
end

for _, p in ipairs(P:GetPlayers()) do CreateESP(p) end

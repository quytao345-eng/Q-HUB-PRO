local function StopT(n)
	if T[n] then
		if typeof(T[n]) == "RBXScriptConnection" then T[n]:Disconnect() else task.cancel(T[n]) end
		T[n] = nil
	end
end

local function ResetCamToSelf()
	local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
	if hum and Cam then Cam.CameraSubject = hum end
end

local function GetNearestPlayer(maxDist)
	maxDist = maxDist or 500
	local closest, shortestDist = nil, maxDist
	local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not myHrp then return nil end
	for _, p in ipairs(P:GetPlayers()) do
		if p ~= LP and p.Character then
			local pHrp = p.Character:FindFirstChild("HumanoidRootPart")
			local pHum = p.Character:FindFirstChildOfClass("Humanoid")
			if pHrp and pHum and pHum.Health > 0 then
				local dist = (pHrp.Position - myHrp.Position).Magnitude
				if dist < shortestDist then
					shortestDist = dist
					closest = p
				end
			end
		end
	end
	return closest
end

local function GetPlayerListNames()
	local names = {}
	for _, p in ipairs(P:GetPlayers()) do
		if p ~= LP then table.insert(names, p.Name) end
	end
	if #names == 0 then table.insert(names, "No players found") end
	return names
end

local function IsVisiblePart(targetPart, wallCheckEnabled)
	if not wallCheckEnabled then return true end
	local myChar = LP.Character
	if not myChar or not targetPart then return false end
	local ignoreList = {myChar, targetPart.Parent}
	local ray = Ray.new(Cam.CFrame.Position, (targetPart.Position - Cam.CFrame.Position).Unit * 500)
	local hit, pos = W:FindPartOnRayWithIgnoreList(ray, ignoreList)
	return hit == nil or hit:IsDescendantOf(targetPart.Parent)
end

local function GetTargetInRedFOV()
	local closestPlayer = nil
	local shortestDistance = targetFOVRadius
	local mousePos = UIS:GetMouseLocation()
	for _, p in ipairs(P:GetPlayers()) do
		if p ~= LP and p.Character then
			local hum = p.Character:FindFirstChildOfClass("Humanoid")
			local hrp = p.Character:FindFirstChild("HumanoidRootPart")
			if hum and hum.Health > 0 and hrp then
				local screenPos, onScreen = Cam:WorldToViewportPoint(hrp.Position)
				if onScreen then
					local distFromMouse = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
					if distFromMouse < shortestDistance then
						if IsVisiblePart(hrp, targetWallCheck) then
							shortestDistance = distFromMouse
							closestPlayer = p
						end
					end
				end
			end
		end
	end
	return closestPlayer
end

local function GetAimTarget()
	local closestPlayer = nil
	local shortestDistance = aimFOV
	local mousePos = UIS:GetMouseLocation()
	for _, p in ipairs(P:GetPlayers()) do
		if p ~= LP and p.Character then
			if not (aimTeamCheck and p.Team == LP.Team) then
				local hum = p.Character:FindFirstChildOfClass("Humanoid")
				local part = p.Character:FindFirstChild(aimPart) or p.Character:FindFirstChild("HumanoidRootPart")
				if hum and hum.Health > 0 and part then
					local screenPos, onScreen = Cam:WorldToViewportPoint(part.Position)
					if onScreen then
						local distFromMouse = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
						if distFromMouse < shortestDistance then
							if IsVisiblePart(part, aimWallCheck) then
								shortestDistance = distFromMouse
								closestPlayer = part
							end
						end
					end
				end
			end
		end
	end
	return closestPlayer
end

-- SILENT AIM HOOK
local rawMeta = getrawmetatable(game)
local oldIndex = rawMeta.__index
setreadonly(rawMeta, false)
rawMeta.__index = newcclosure(function(self, key)
	if not checkcaller() and silentAimEnabled then
		if self == Mouse then
			local targetPart = GetAimTarget()
			if targetPart then
				if key == "Hit" or key == "hit" then return targetPart.CFrame
				elseif key == "Target" or key == "target" then return targetPart
				elseif key == "X" or key == "x" then return Cam:WorldToViewportPoint(targetPart.Position).X
				elseif key == "Y" or key == "y" then return Cam:WorldToViewportPoint(targetPart.Position).Y
				end
			end
		end
	end
	return oldIndex(self, key)
end)
setreadonly(rawMeta, true)


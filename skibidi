local function CreateESPObj(plr)
	if espObjects[plr] then return end
	
	local hl = Instance.new("Highlight")
	hl.FillTransparency = 1
	hl.OutlineColor = Color3.fromRGB(255, 45, 85)
	hl.OutlineTransparency = 0
	hl.Enabled = false

	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(0, 200, 0, 50)
	bb.AlwaysOnTop = true
	bb.ExtentsOffset = Vector3.new(0, 3, 0)
	bb.Enabled = false

	local txtLabel = Instance.new("TextLabel", bb)
	txtLabel.Size = UDim2.new(1, 0, 1, 0)
	txtLabel.BackgroundTransparency = 1
	txtLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	txtLabel.TextSize = 16
	txtLabel.Font = Enum.Font.GothamBold
	txtLabel.TextStrokeTransparency = 0

	local tracer = Drawing and Drawing.new("Line") or nil
	if tracer then
		tracer.Color = Color3.fromRGB(255, 45, 85)
		tracer.Thickness = 1.5
		tracer.Visible = false
	end

	local box = Drawing and Drawing.new("Square") or nil
	if box then
		box.Color = Color3.fromRGB(255, 45, 85)
		box.Thickness = 1.5
		box.Filled = false
		box.Visible = false
	end

	espObjects[plr] = {
		Highlight = hl,
		Billboard = bb,
		TextLabel = txtLabel,
		Tracer = tracer,
		Box = box
	}
end

local function RemoveESPObj(plr)
	if espObjects[plr] then
		if espObjects[plr].Highlight then espObjects[plr].Highlight:Destroy() end
		if espObjects[plr].Billboard then espObjects[plr].Billboard:Destroy() end
		if espObjects[plr].Tracer then espObjects[plr].Tracer:Remove() end
		if espObjects[plr].Box then espObjects[plr].Box:Remove() end
		espObjects[plr] = nil
	end
end

RS.RenderStepped:Connect(function()
	for _, p in ipairs(P:GetPlayers()) do
		if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			CreateESPObj(p)
			local data = espObjects[p]
			local char = p.Character
			local hrp = char:FindFirstChild("HumanoidRootPart")
			local hum = char:FindFirstChildOfClass("Humanoid")

			if hrp and hum and hum.Health > 0 then
				if espHighlight then
					data.Highlight.Parent = char
					data.Highlight.Enabled = true
				else
					data.Highlight.Enabled = false
				end

				if espName or espHealth then
					data.Billboard.Parent = hrp
					data.Billboard.Enabled = true
					local textStr = ""
					if espName then textStr = textStr .. p.Name end
					if espHealth then textStr = textStr .. " [" .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth) .. " HP]" end
					data.TextLabel.Text = textStr
				else
					data.Billboard.Enabled = false
				end

				local screenPos, onScreen = Cam:WorldToViewportPoint(hrp.Position)

				if espTracer and data.Tracer and Cam then
					if onScreen then
						data.Tracer.From = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y)
						data.Tracer.To = Vector2.new(screenPos.X, screenPos.Y)
						data.Tracer.Visible = true
					else
						data.Tracer.Visible = false
					end
				elseif data.Tracer then
					data.Tracer.Visible = false
				end

				if espBox and data.Box and Cam then
					if onScreen then
						local head = char:FindFirstChild("Head")
						local headPos = head and Cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or screenPos
						local legPos = Cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
						
						local height = math.abs(headPos.Y - legPos.Y)
						local width = height / 1.5

						data.Box.Size = Vector2.new(width, height)
						data.Box.Position = Vector2.new(screenPos.X - width / 2, screenPos.Y - height / 2)
						data.Box.Visible = true
					else
						data.Box.Visible = false
					end
				elseif data.Box then
					data.Box.Visible = false
				end
			else
				if data.Highlight then data.Highlight.Enabled = false end
				if data.Billboard then data.Billboard.Enabled = false end
				if data.Tracer then data.Tracer.Visible = false end
				if data.Box then data.Box.Visible = false end
			end
		else
			RemoveESPObj(p)
		end
	end
end)


    -- ESP SYSTEM
    local function CreateESP(plr)
        if plr == LP then return end

        local function SetupCharacter(char)
            if not char then return end

            local hrp = char:WaitForChild("HumanoidRootPart", 10)
            local hum = char:WaitForChild("Humanoid", 10)
            if not hrp or not hum then return end

            local hl = char:FindFirstChild("QHub_Highlight") or Instance.new("Highlight")
            hl.Name = "QHub_Highlight"
            hl.FillTransparency = 0.5
            hl.FillColor = Color3.fromRGB(255, 45, 85)
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.OutlineTransparency = 0
            hl.Enabled = espHighlight
            hl.Parent = char

            local bb = hrp:FindFirstChild("QHub_Billboard") or Instance.new("BillboardGui")
            bb.Name = "QHub_Billboard"
            bb.Size = UDim2.new(0, 200, 0, 60)
            bb.AlwaysOnTop = true
            bb.ExtentsOffset = Vector3.new(0, 3.5, 0)
            bb.Enabled = (espName or espHealth or espDistance)
            bb.Parent = hrp

            local txtLabel = bb:FindFirstChild("TextLabel") or Instance.new("TextLabel")
            txtLabel.Parent = bb
            txtLabel.Size = UDim2.new(1, 0, 1, 0)
            txtLabel.BackgroundTransparency = 1
            txtLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            txtLabel.TextSize = 13
            txtLabel.Font = Enum.Font.SourceSansBold
            txtLabel.TextStrokeTransparency = 0

            local boxBb = hrp:FindFirstChild("QHub_BoxGui") or Instance.new("BillboardGui")
            boxBb.Name = "QHub_BoxGui"
            boxBb.Size = UDim2.new(4.5, 0, 6, 0)
            boxBb.AlwaysOnTop = true
            boxBb.Enabled = espBox
            boxBb.Parent = hrp

            local boxFrame = boxBb:FindFirstChild("BoxFrame") or Instance.new("Frame")
            boxFrame.Name = "BoxFrame"
            boxFrame.Size = UDim2.new(1, 0, 1, 0)
            boxFrame.BackgroundTransparency = 1
            boxFrame.Parent = boxBb

            local corner = boxFrame:FindFirstChild("UICorner") or Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 4)
            corner.Parent = boxFrame

            local function UpdateESP()
                if not hum or not hum.Parent or not hrp or not hrp.Parent then return end
                local infoText = ""
                if espName then infoText = infoText .. plr.Name .. "\n" end
                if espHealth then infoText = infoText .. "[" .. math.floor(math.max(0, hum.Health)) .. "/" .. math.floor(hum.MaxHealth) .. " HP] " end
                if espDistance then
                    local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                    if myHrp then
                        local dist = math.floor((myHrp.Position - hrp.Position).Magnitude)
                        infoText = infoText .. "[" .. dist .. "m]"
                    end
                end
                txtLabel.Text = infoText
            end

            hum.HealthChanged:Connect(UpdateESP)
            UpdateESP()
        end

        if plr.Character then task.spawn(function() SetupCharacter(plr.Character) end) end
        plr.CharacterAdded:Connect(function(newChar) task.spawn(function() SetupCharacter(newChar) end) end)
    end


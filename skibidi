    local function StartTargetingPlayer(plr, forceEnable)
        if not plr or plr == LP then return end
        SelectedTargetPlayer = plr
        if forceEnable then
            targetModeEnabled = true
            SyncAllTargetUI(true)
        end
        if not targetModeEnabled then return end

        local TARGET_BIND = "QHub_TargetFollow"
        pcall(function() RS:UnbindFromRenderStep(TARGET_BIND) end)

        local function followStep(dt)
            if not targetModeEnabled then return end
            local char = LP.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local tPlr = SelectedTargetPlayer
            if not tPlr or not tPlr.Parent then
                targetModeEnabled = false
                StopTargeting()
                SyncAllTargetUI(false)
                return
            end
            local tChar = tPlr.Character
            local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
            local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
            if not tHrp or not tHum or tHum.Health <= 0 then
                targetModeEnabled = false
                StopTargeting()
                SyncAllTargetUI(false)
                return
            end
            if not hrp then return end

            local dist = math.max(0.5, behindDistance or 6)
            local mode = targetPositionMode or "Top"
            dt = dt or 0.016

            if ShouldAutoView() and Cam.CameraSubject ~= tHum then
                ViewTargetPlayer(tPlr)
            end

            local function lockPhysics()
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
                local myHum = char:FindFirstChildOfClass("Humanoid")
                if myHum then pcall(function() myHum:ChangeState(Enum.HumanoidStateType.Physics) end) end
            end

            if mode == "Top" then
                hrp.CFrame = CFrame.new(tHrp.Position + Vector3.new(0, dist, 0), tHrp.Position)
                lockPhysics()
            elseif mode == "Under" then
                hrp.CFrame = CFrame.new(tHrp.Position + Vector3.new(0, -dist, 0), tHrp.Position)
                lockPhysics()
            elseif mode == "Spin" then
                spinAngle = spinAngle + dt * spinSpeed
                local pos = tHrp.Position + Vector3.new(math.cos(spinAngle) * dist, 1.5, math.sin(spinAngle) * dist)
                hrp.CFrame = CFrame.new(pos, tHrp.Position)
                lockPhysics()
            elseif mode == "Behind" then
                hrp.CFrame = hrp.CFrame:Lerp(tHrp.CFrame * CFrame.new(0, 0, dist), math.clamp(targetSmooth, 0.1, 1))
            else
                local front = tHrp.CFrame * CFrame.new(0, 0, -dist)
                hrp.CFrame = hrp.CFrame:Lerp(CFrame.new(front.Position, tHrp.Position), math.clamp(targetSmooth, 0.1, 1))
            end
        end

        local ok = pcall(function()
            RS:BindToRenderStep(TARGET_BIND, Enum.RenderPriority.Camera.Value + 1, followStep)
        end)
        if not ok then
            T.Behind = RS.Heartbeat:Connect(function(dt) pcall(followStep, dt) end)
        else
            T.Behind = TARGET_BIND
        end
        UpdateTargetView()
    end


    local function IsVisiblePart(targetPart, wallCheckEnabled)
        if not wallCheckEnabled or not targetPart then return true end
        local myChar = LP.Character
        if not myChar then return false end
        local origin = Cam.CFrame.Position
        local dir = (targetPart.Position - origin)
        if dir.Magnitude < 1 then return true end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { myChar, targetPart.Parent }
        local result = W:Raycast(origin, dir.Unit * math.min(dir.Magnitude, 500), params)
        return result == nil or (result.Instance and result.Instance:IsDescendantOf(targetPart.Parent))
    end

    local function GetClosestTargetToMouseFOV(radius, wallCheck, teamCheck, specificPart)
        local closestPart, closestPlayer, shortestDistance = nil, nil, radius
        local fovCenterPos = Vector2.new(Mouse.X, Mouse.Y + fixedPovOffset)

        for _, p in ipairs(P:GetPlayers()) do
            if p ~= LP and p.Character and not (teamCheck and p.Team == LP.Team) then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local part = specificPart and (p.Character:FindFirstChild(specificPart) or p.Character:FindFirstChild("HumanoidRootPart")) or p.Character:FindFirstChild("HumanoidRootPart")
                    if part then
                        local screenPos, onScreen = Cam:WorldToViewportPoint(part.Position)
                        if onScreen then
                            local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - fovCenterPos).Magnitude
                            if distFromCenter < shortestDistance and IsVisiblePart(part, wallCheck) then
                                shortestDistance = distFromCenter
                                closestPart, closestPlayer = part, p
                            end
                        end
                    end
                end
            end
        end
        return closestPart, closestPlayer
    end


        local char = LP.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")

            if hum and hrp then
                hum.UseJumpPower = true
                hum.JumpPower = jumpPower

                if speedToggleEnabled and not flyEnabled then
                    if hum.MoveDirection.Magnitude > 0 then
                        local targetVelocity = hum.MoveDirection * walkSpeed
                        hrp.CFrame = hrp.CFrame + (targetVelocity * dt)
                        hrp.AssemblyLinearVelocity = Vector3.new(targetVelocity.X, hrp.AssemblyLinearVelocity.Y, targetVelocity.Z)
                    else
                        hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
                    end
                end
            end
        end
    end)

    -- Hotkey trigger (đặt sau khi Toggle* đã khai báo)
    UIS.InputBegan:Connect(function(input, gameProcessed)
        if waitingForKeybind then return end
        if UIS:GetFocusedTextBox() then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

        -- Menu: Ctrl (mặc định) — không chặn bởi gameProcessed
        if input.KeyCode == menuKeybind or input.KeyCode == Enum.KeyCode.RightControl then
            pcall(ToggleUI)
            return
        end

        if gameProcessed then return end

        if input.KeyCode == tpAllKeybind then
            local newState = not tpAllEnabled
            if tpAllToggleUI and tpAllToggleUI.Set then
                pcall(function() tpAllToggleUI:Set(newState) end)
            else
                ToggleTPAll(newState)
            end
        elseif input.KeyCode == targetKeybind then
            pcall(ToggleTargetMode)
        elseif input.KeyCode == flyKeybind then
            local newState = not flyEnabled
            if flyToggleUI and flyToggleUI.Set then
                pcall(function() flyToggleUI:Set(newState) end)
            else
                ToggleFly(newState)
            end
        end
    end)

    -- Select first tab
    pcall(function()
        if Tabs.Info and Tabs.Info.Select then
            Tabs.Info:Select()
        end
    end)

    WindUI:Notify({
        Title = "Q HUB",
        Content = "Loaded with WindUI!",
        Duration = 3,
        Icon = "zap"
    })
end)

if not success then
    warn("Q HUB Error: " .. tostring(err))
end

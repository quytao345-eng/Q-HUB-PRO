            bg.cframe = hrp.CFrame
            bg.Parent = hrp

            local bv = Instance.new("BodyVelocity")
            bv.Name = "QHub_FlyVel"
            bv.velocity = Vector3.zero
            bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
            bv.Parent = hrp

            T.Fly = RS.RenderStepped:Connect(function()
                if not flyEnabled or not hrp or not hrp.Parent then
                    StopT("Fly")
                    if bg then bg:Destroy() end
                    if bv then bv:Destroy() end
                    if hum then hum.PlatformStand = false end
                    return
                end

                bg.cframe = Cam.CFrame
                local moveVector = Vector3.zero
                local camCF = Cam.CFrame

                if UIS:IsKeyDown(Enum.KeyCode.W) then moveVector = moveVector + camCF.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.S) then moveVector = moveVector - camCF.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.A) then moveVector = moveVector - camCF.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.D) then moveVector = moveVector + camCF.RightVector end

                if hum.MoveDirection.Magnitude > 0 then
                    moveVector = moveVector + (camCF.LookVector * (hum.MoveDirection:Dot(camCF.LookVector)))
                    moveVector = moveVector + (camCF.RightVector * (hum.MoveDirection:Dot(camCF.RightVector)))
                end

                if moveVector.Magnitude > 0 then
                    bv.velocity = moveVector.Unit * flySpeed
                else
                    bv.velocity = Vector3.zero
                end
            end)
        else
            StopT("Fly")
            if hrp then
                local bg = hrp:FindFirstChild("QHub_FlyGyro")
                local bv = hrp:FindFirstChild("QHub_FlyVel")
                if bg then bg:Destroy() end
                if bv then bv:Destroy() end
            end
            if hum then hum.PlatformStand = false end
        end
    end

    flyToggleUI = Tabs.Misc:Toggle({
        Title = "Fly Mode",
        Value = false,
        Callback = function(state) ToggleFly(state) end
    })

    flyKeybindBtn = Tabs.Misc:Button({
        Title = "Fly Hotkey: [" .. KeyCodeToName(flyKeybind) .. "]",
        Desc = "Bấm để đổi phím · nhấn phím mới",
        Callback = function()
            waitingForKeybind = "fly"
            if flyKeybindBtn and flyKeybindBtn.SetTitle then
                pcall(function() flyKeybindBtn:SetTitle("Fly Hotkey: [ ... ]") end)
            end
            WindUI:Notify({ Title = "Q HUB", Content = "Nhấn phím mới cho Fly...", Duration = 2 })
        end
    })

    Tabs.Misc:Input({
        Title = "Fly Speed",
        Value = "50",
        Placeholder = "Speed",
        Callback = function(txt)
            local num = tonumber(txt)
            if num then flySpeed = num end
        end
    })
    Tabs.Misc:Toggle({
        Title = "Smooth Speed",
        Value = false,
        Callback = function(state) speedToggleEnabled = state end
    })
    Tabs.Misc:Input({
        Title = "Speed Value",
        Value = "50",
        Placeholder = "WalkSpeed",
        Callback = function(txt)
            local num = tonumber(txt)
            if num then walkSpeed = num end
        end
    })
    Tabs.Misc:Input({
        Title = "Jump Power",
        Value = "50",
        Placeholder = "JumpPower",
        Callback = function(txt)
            local num = tonumber(txt)
            if num then jumpPower = num end
        end
    })
    Tabs.Misc:Toggle({
        Title = "Infinite Jump",
        Value = false,
        Callback = function(state) infJumpEnabled = state end
    })

    UIS.JumpRequest:Connect(function()
        if infJumpEnabled and LP.Character then
            local hum = LP.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum:ChangeState("Jumping") end
        end
    end)

    Tabs.Misc:Toggle({
        Title = "Noclip",
        Value = false,
        Callback = function(state)
            noclipEnabled = state
            if state then
                T.Noclip = RS.Stepped:Connect(function()
                    if LP.Character and noclipEnabled then
                        for _, part in ipairs(LP.Character:GetDescendants()) do
                            if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end
                        end
                    end
                end)
            else
                StopT("Noclip")
            end
        end
    })

    Tabs.Misc:Button({
        Title = "Rejoin",
        Callback = function()
            game:GetService("TeleportService"):Teleport(game.PlaceId, LP)
        end
    })

    -- MAIN LOOP FOR SPEED
    RS.Heartbeat:Connect(function(dt)
        local char = LP.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")

            if hum and hrp then
                hum.UseJumpPower = true
                hum.JumpPower = jumpPower

                if speedToggleEnabled and not flyEnabled then
                    if hum.MoveDirection.Magnitude > 0 then
                        local targetVelocity = hum.MoveDirection * walkSpeed
                        hrp.CFrame = hrp.CFrame + (targetVelocity * dt)
                        hrp.AssemblyLinearVelocity = Vector3.new(targetVelocity.X, hrp.AssemblyLinearVelocity.Y, targetVelocity.Z)
                    else
                        hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
                    end
                end
            end
        end
    end)

    -- Hotkey trigger (đặt sau khi Toggle* đã khai báo)
    UIS.InputBegan:Connect(function(input, gameProcessed)
        if waitingForKeybind then return end
        if gameProcessed or UIS:GetFocusedTextBox() then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

        if input.KeyCode == tpAllKeybind then
            local newState = not tpAllEnabled
            if tpAllToggleUI and tpAllToggleUI.Set then
                pcall(function() tpAllToggleUI:Set(newState) end)
            else
                ToggleTPAll(newState)
            end
        elseif input.KeyCode == targetKeybind then
            pcall(ToggleTargetMode)
        elseif input.KeyCode == flyKeybind then
            local newState = not flyEnabled
            if flyToggleUI and flyToggleUI.Set then
                pcall(function() flyToggleUI:Set(newState) end)
            else
                ToggleFly(newState)
            end
        end
    end)

    -- Select first tab
    pcall(function()
        if Tabs.Info and Tabs.Info.Select then
            Tabs.Info:Select()
        end
    end)

    WindUI:Notify({
        Title = "Q HUB",
        Content = "Loaded with WindUI!",
        Duration = 3,
        Icon = "zap"
    })
end)

if not success then
    warn("Q HUB Error: " .. tostring(err))
end

    -- ESP SYSTEM (Box + Tracer + Health bar thẳng + Name/Distance)
    local ESPData = {} -- [player] = { drawings / guis }

    local function HasDrawing()
        return typeof(Drawing) == "table" and type(Drawing.new) == "function"
    end

    local function NewDraw(class, props)
        if not HasDrawing() then return nil end
        local ok, obj = pcall(function() return Drawing.new(class) end)
        if not ok or not obj then return nil end
        if props then
            for k, v in pairs(props) do
                pcall(function() obj[k] = v end)
            end
        end
        return obj
    end

    local function ClearPlayerESP(plr)
        local d = ESPData[plr]
        if not d then return end
        for _, obj in pairs(d) do
            pcall(function()
                if typeof(obj) == "Instance" then
                    obj:Destroy()
                elseif type(obj) == "table" and obj.Remove then
                    obj:Remove()
                elseif type(obj) == "userdata" or type(obj) == "table" then
                    if obj.Remove then obj:Remove()
                    elseif obj.Destroy then obj:Destroy()
                    else pcall(function() obj.Visible = false end) end
                end
            end)
        end
        ESPData[plr] = nil
        if plr.Character then
            local hl = plr.Character:FindFirstChild("QHub_Highlight")
            if hl then pcall(function() hl:Destroy() end) end
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                for _, n in ipairs({ "QHub_Billboard", "QHub_BoxGui", "QHub_HPGui" }) do
                    local g = hrp:FindFirstChild(n)
                    if g then pcall(function() g:Destroy() end) end
                end
            end
        end
    end

    local function CreateESP(plr)
        if plr == LP then return end
        ClearPlayerESP(plr)

        local function SetupCharacter(char)
            if not char or plr == LP then return end
            local hrp = char:WaitForChild("HumanoidRootPart", 8)
            local hum = char:WaitForChild("Humanoid", 8)
            if not hrp or not hum then return end

            ClearPlayerESP(plr)
            local data = {}

            -- Highlight
            local hl = Instance.new("Highlight")
            hl.Name = "QHub_Highlight"
            hl.FillTransparency = 0.55
            hl.FillColor = Color3.fromRGB(255, 45, 85)
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.OutlineTransparency = 0
            hl.Enabled = espHighlight
            hl.Parent = char
            data.hl = hl

            -- Name + Distance billboard (trên đầu)
            local bb = Instance.new("BillboardGui")
            bb.Name = "QHub_Billboard"
            bb.Size = UDim2.new(0, 180, 0, 40)
            bb.StudsOffset = Vector3.new(0, 3.2, 0)
            bb.AlwaysOnTop = true
            bb.Enabled = (espName or espDistance)
            bb.Parent = hrp
            local nameLbl = Instance.new("TextLabel")
            nameLbl.Name = "Info"
            nameLbl.BackgroundTransparency = 1
            nameLbl.Size = UDim2.new(1, 0, 1, 0)
            nameLbl.Font = Enum.Font.GothamBold
            nameLbl.TextSize = 14
            nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
            nameLbl.TextStrokeTransparency = 0.3
            nameLbl.Text = plr.Name
            nameLbl.Parent = bb
            data.bb = bb
            data.nameLbl = nameLbl

            -- Box ESP (khung quanh người) — Billboard + UIStroke
            local boxBb = Instance.new("BillboardGui")
            boxBb.Name = "QHub_BoxGui"
            boxBb.Size = UDim2.new(4, 0, 5.5, 0)
            boxBb.StudsOffset = Vector3.new(0, 0.5, 0)
            boxBb.AlwaysOnTop = true
            boxBb.Enabled = espBox
            boxBb.Parent = hrp
            local boxFrame = Instance.new("Frame")
            boxFrame.Name = "Box"
            boxFrame.Size = UDim2.new(1, 0, 1, 0)
            boxFrame.BackgroundTransparency = 0.85
            boxFrame.BackgroundColor3 = Color3.fromRGB(255, 45, 85)
            boxFrame.BorderSizePixel = 0
            boxFrame.Parent = boxBb
            local stroke = Instance.new("UIStroke")
            stroke.Thickness = 2
            stroke.Color = Color3.fromRGB(255, 255, 255)
            stroke.Parent = boxFrame
            data.boxBb = boxBb

            -- Health bar THẲNG đứng (bên cạnh)
            local hpBb = Instance.new("BillboardGui")
            hpBb.Name = "QHub_HPGui"
            hpBb.Size = UDim2.new(0, 6, 0, 70)
            hpBb.StudsOffset = Vector3.new(2.4, 0.5, 0)
            hpBb.AlwaysOnTop = true
            hpBb.Enabled = espHealth
            hpBb.Parent = hrp
            local hpBg = Instance.new("Frame")
            hpBg.Name = "HPBG"
            hpBg.Size = UDim2.new(1, 0, 1, 0)
            hpBg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            hpBg.BorderSizePixel = 0
            hpBg.Parent = hpBb
            local hpFill = Instance.new("Frame")
            hpFill.Name = "HPFill"
            hpFill.AnchorPoint = Vector2.new(0, 1)
            hpFill.Position = UDim2.new(0, 0, 1, 0)
            hpFill.Size = UDim2.new(1, 0, 1, 0)
            hpFill.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
            hpFill.BorderSizePixel = 0
            hpFill.Parent = hpBg
            data.hpBb = hpBb
            data.hpFill = hpFill

            -- Tracer (dây) — Drawing Line nếu có
            local tracer = NewDraw("Line", {
                Thickness = 1.5,
                Color = Color3.fromRGB(255, 45, 85),
                Transparency = 0.2,
                Visible = false,
            })
            data.tracer = tracer

            ESPData[plr] = data

            local function refreshHP()
                if not hum or not hum.Parent then return end
                local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                if data.hpFill then
                    data.hpFill.Size = UDim2.new(1, 0, ratio, 0)
                    -- xanh → vàng → đỏ
                    if ratio > 0.5 then
                        data.hpFill.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
                    elseif ratio > 0.25 then
                        data.hpFill.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
                    else
                        data.hpFill.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
                    end
                end
            end
            hum.HealthChanged:Connect(refreshHP)
            refreshHP()
        end

        if plr.Character then task.spawn(SetupCharacter, plr.Character) end
        plr.CharacterAdded:Connect(function(c) task.spawn(SetupCharacter, c) end)
        plr.CharacterRemoving:Connect(function() ClearPlayerESP(plr) end)
    end


    -- Smooth Speed (CFrame) - né anti WalkSpeed, có animation, 16 = bình thường
    local speedConn = nil

    local function StopSmoothSpeed()
        speedEnabled = false
        if speedConn then
            pcall(function() speedConn:Disconnect() end)
            speedConn = nil
        end
    end

    local function StartSmoothSpeed()
        if speedConn then return end
        speedConn = RS.Heartbeat:Connect(function(dt)
            if not speedEnabled or flyEnabled then return end
            local char = LP.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hum or not hrp then return end

            local dir = hum.MoveDirection
            local vy = hrp.AssemblyLinearVelocity.Y

            if dir.Magnitude < 0.05 then
                -- Dừng ngay, không trượt
                hrp.AssemblyLinearVelocity = Vector3.new(0, vy, 0)
                return
            end

            -- walkSpeed giống WalkSpeed: 16 = bình thường (studs/s)
            local speed = walkSpeed
            local move = dir.Unit * speed * dt
            hrp.CFrame = hrp.CFrame + Vector3.new(move.X, 0, move.Z)

            -- Giữ velocity nhẹ theo hướng để animation đi bộ chạy
            local animVel = dir.Unit * math.min(speed, 16)
            hrp.AssemblyLinearVelocity = Vector3.new(animVel.X, vy, animVel.Z)

            -- Giữ state Running để animation không bị mất
            pcall(function()
                if hum:GetState() ~= Enum.HumanoidStateType.Running
                    and hum:GetState() ~= Enum.HumanoidStateType.RunningNoPhysics then
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                end
            end)
        end)
    end


-- LOGIC TOGGLE FOV ORBIT BẰNG PHÍM TẮT
local function ToggleFOVOrbit()
	fovOrbitActive = not fovOrbitActive
	if fovOrbitActive then
		local target = GetTargetInRedFOV()
		if target then
			currentFOVTarget = target
			T.RedOrbit = RS.Heartbeat:Connect(function(dt)
				local char = LP.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				local tChar = currentFOVTarget and currentFOVTarget.Character
				local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
				local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")

				if not currentFOVTarget or not tChar or not tHrp or not tHum or tHum.Health <= 0 or not fovOrbitActive then
					StopT("RedOrbit")
					ResetCamToSelf()
					fovOrbitActive = false
					currentFOVTarget = nil
					return
				end

				if hrp and tHrp then
					if Cam and Cam.CameraSubject ~= tHum then Cam.CameraSubject = tHum end
					orbitAngle = orbitAngle + (orbitSpeed * dt)
					local offsetX = math.cos(orbitAngle) * orbitDistance
					local offsetZ = math.sin(orbitAngle) * orbitDistance
					local targetPos = tHrp.Position
					local newPos = Vector3.new(targetPos.X + offsetX, targetPos.Y, targetPos.Z + offsetZ)
					hrp.CFrame = CFrame.new(newPos, Vector3.new(targetPos.X, newPos.Y, targetPos.Z))
					hrp.AssemblyLinearVelocity = Vector3.zero
				end
			end)
		else
			fovOrbitActive = false
		end
	else
		StopT("RedOrbit")
		ResetCamToSelf()
		currentFOVTarget = nil
	end
end


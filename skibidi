    -- MOBILE FIXED CFRAME FLY
    Tabs.Misc:AddToggle("FlyMode", { Title = "Fly Mobile", Default = false, Callback = function(state)
        flyEnabled = state
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end

        if flyEnabled then
            T.Fly = RS.RenderStepped:Connect(function(dt)
                if not flyEnabled or not hrp or not hrp.Parent then StopT("Fly") return end
                
                hrp.AssemblyLinearVelocity = Vector3.zero
                
                local moveDir = hum.MoveDirection
                if moveDir.Magnitude > 0 then
                    local camCF = Cam.CFrame
                    local flyVector = (camCF.LookVector * moveDir.Z * -1) + (camCF.RightVector * moveDir.X)
                    hrp.CFrame = hrp.CFrame + (flyVector * (flySpeed * dt))
                end
            end)
        else 
            StopT("Fly") 
        end
    end })


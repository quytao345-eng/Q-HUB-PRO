    -- TP ALL FUNCTION & KEYBIND
    local function ToggleTPAll(state)
        if state == nil then state = not tpAllEnabled end
        tpAllEnabled = state

        if tpAllEnabled then
            T.Teleport = task.spawn(function()
                local isSkyFalling = false
                while tpAllEnabled do
                    local alivePlayers = {}
                    for _, p in ipairs(P:GetPlayers()) do
                        if p ~= LP and not table.find(tpBlacklist, p.Name) and p.Character then
                            local tr = p.Character:FindFirstChild("HumanoidRootPart")
                            local hum = p.Character:FindFirstChildOfClass("Humanoid")
                            if tr and hum and hum.Health > 0 then table.insert(alivePlayers, tr) end
                        end
                    end

                    local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                    if myHrp then
                        if #alivePlayers > 0 then
                            isSkyFalling = false
                            for _, targetHrp in ipairs(alivePlayers) do
                                if targetHrp and targetHrp.Parent and tpAllEnabled then
                                    myHrp.CFrame = (targetHrp.CFrame * CFrame.new(0, -3.5, 0)) * CFrame.Angles(math.rad(90), 0, 0)
                                    myHrp.AssemblyLinearVelocity = Vector3.zero
                                    task.wait(0.0002)
                                end
                            end
                        else
                            if not isSkyFalling then
                                isSkyFalling = true
                                myHrp.CFrame = myHrp.CFrame + Vector3.new(0, 500, 0)
                                myHrp.AssemblyLinearVelocity = Vector3.zero
                            end
                            task.wait(0.1)
                        end
                    else task.wait(0.05) end
                end
            end)
        else
            StopT("Teleport")
        end
    end


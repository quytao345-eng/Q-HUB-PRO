        SelectedTargetPlayer = nil
        RestoreGravity()
        ResetCamToSelf() -- tắt view khi stop target
    end

    local function StartTargetingPlayer(plr, forceEnable)
        if not plr or plr == LP then return end
        SelectedTargetPlayer = plr

        if forceEnable then
            targetModeEnabled = true
            SyncAllTargetUI(true)
        end
        if not targetModeEnabled then
            return
        end

        local TARGET_BIND = "QHub_TargetFollow"
        -- Unbind sạch trước khi bind lại (tránh stack → crash)
        pcall(function() RS:UnbindFromRenderStep(TARGET_BIND) end)
        if T.Behind then
            pcall(function()
                if typeof(T.Behind) == "RBXScriptConnection" then
                    T.Behind:Disconnect()
                end
            end)
            T.Behind = nil
        end

        local function stopFollowOnly()
            pcall(function() RS:UnbindFromRenderStep(TARGET_BIND) end)
            if T.Behind then
                pcall(function()
                    if typeof(T.Behind) == "RBXScriptConnection" then T.Behind:Disconnect() end
                end)
                T.Behind = nil
            end
        end

        local function followStep(dt)
            if not targetModeEnabled then
                stopFollowOnly()
                return
            end
            local char = LP.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local tPlr = SelectedTargetPlayer
            if not tPlr or not tPlr.Parent then
                -- Target out server
                targetModeEnabled = false
                stopFollowOnly()
                SelectedTargetPlayer = nil
                RestoreGravity()
                ResetCamToSelf()
                task.defer(function() SyncAllTargetUI(false) end)
                return
            end
            local tChar = tPlr.Character
            local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
            local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
            if not tHrp or not tHum or tHum.Health <= 0 then
                -- Target chết
                targetModeEnabled = false
                stopFollowOnly()
                SelectedTargetPlayer = nil
                RestoreGravity()
                ResetCamToSelf()
                task.defer(function() SyncAllTargetUI(false) end)
                return
            end
            if not hrp then return end

            local dist = math.max(0.5, behindDistance or 6)
            local mode = targetPositionMode or "Top"
            local myHum = char:FindFirstChildOfClass("Humanoid")
            dt = dt or 0.016

            -- Auto view khi Under / Spin
            if ShouldAutoView() then
                if Cam.CameraSubject ~= tHum then
                    ViewTargetPlayer(tPlr)
                end
            end

            local function lockPhysics()
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
                if myHum then
                    pcall(function()
                        myHum:ChangeState(Enum.HumanoidStateType.Physics)
                    end)
                end
            end

            if mode == "Top" then
                local topPos = tHrp.Position + Vector3.new(0, dist, 0)
                hrp.CFrame = CFrame.new(topPos, tHrp.Position)
                lockPhysics()
            elseif mode == "Under" then
                -- Ở dưới target, nhìn lên
                local underPos = tHrp.Position + Vector3.new(0, -dist, 0)
                hrp.CFrame = CFrame.new(underPos, tHrp.Position)
                lockPhysics()
            elseif mode == "Spin" then
                -- Quay quanh target
                spinAngle = spinAngle + dt * spinSpeed
                local ox = math.cos(spinAngle) * dist
                local oz = math.sin(spinAngle) * dist
                local spinPos = tHrp.Position + Vector3.new(ox, 1.5, oz)
                hrp.CFrame = CFrame.new(spinPos, tHrp.Position)
                lockPhysics()
            elseif mode == "Behind" then
                local goalCF = tHrp.CFrame * CFrame.new(0, 0, dist)
                local alpha = math.clamp((targetSmooth or 0.35), 0.1, 1)
                hrp.CFrame = hrp.CFrame:Lerp(goalCF, alpha)
                local vel = hrp.AssemblyLinearVelocity
                hrp.AssemblyLinearVelocity = Vector3.new(vel.X * 0.2, 0, vel.Z * 0.2)
            else -- Front
                local front = tHrp.CFrame * CFrame.new(0, 0, -dist)
                local goalCF = CFrame.new(front.Position, tHrp.Position)
                local alpha = math.clamp((targetSmooth or 0.35), 0.1, 1)
                hrp.CFrame = hrp.CFrame:Lerp(goalCF, alpha)
                local vel = hrp.AssemblyLinearVelocity
                hrp.AssemblyLinearVelocity = Vector3.new(vel.X * 0.2, 0, vel.Z * 0.2)
            end
        end

        local bindOk = pcall(function()
            RS:BindToRenderStep(TARGET_BIND, Enum.RenderPriority.Camera.Value + 1, followStep)
        end)
        if not bindOk then
            -- Fallback Heartbeat nếu BindToRenderStep fail
            T.Behind = RS.Heartbeat:Connect(function(dt)
                pcall(followStep, dt)
            end)
        else
            T.Behind = TARGET_BIND -- marker
        end

        -- Bật view ngay nếu mode Under/Spin
        UpdateTargetView()
    end


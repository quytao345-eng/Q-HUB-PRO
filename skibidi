				if hrp.Position.Y > W.FallenPartsDestroyHeight + 50 then
					lastSafeCFrame = hrp.CFrame
				elseif hrp.Position.Y <= W.FallenPartsDestroyHeight + 15 then
					if lastSafeCFrame then
						hrp.CFrame = lastSafeCFrame + Vector3.new(0, 5, 0)
						hrp.AssemblyLinearVelocity = Vector3.zero
					else
						hrp.CFrame = CFrame.new(hrp.Position.X, 20, hrp.Position.Z)
					end
				end
			end
		end)
	else 
		StopT("AntiVoid") 
		if antiVoidPart then antiVoidPart:Destroy() antiVoidPart = nil end
	end
end })

-- FLING V2 (ROTATIONAL ANGULAR VELOCITY ATTACHMENT)
Tabs.Misc:AddToggle("FlingToggle", { Title = "Advanced Fling", Default = false, Callback = function(state)
	flingEnabled = state
	if state then
		T.Fling = RS.Heartbeat:Connect(function()
			local char = LP.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not hrp or not flingEnabled then StopT("Fling") return end

			hrp.AssemblyAngularVelocity = Vector3.new(0, 999999, 0)
			for _, p in ipairs(P:GetPlayers()) do
				if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
					local pHrp = p.Character.HumanoidRootPart
					if (hrp.Position - pHrp.Position).Magnitude < 6 then
						hrp.CFrame = pHrp.CFrame * CFrame.new(0, 0, 0)
					end
				end
			end
		end)
	else
		StopT("Fling")
		local char = LP.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp then hrp.AssemblyAngularVelocity = Vector3.zero end
	end
end })

-- ANTI-FLING V2 (NON-COLLIDE & ZERO VELOCITY LOCK)
Tabs.Misc:AddToggle("AntiFlingToggle", { Title = "Anti-Fling V2", Default = false, Callback = function(state)
	antiFlingEnabled = state
	if state then
		T.AntiFling = RS.Stepped:Connect(function()
			if not antiFlingEnabled then StopT("AntiFling") return end
			local char = LP.Character
			if char then
				for _, part in ipairs(char:GetDescendants()) do
					if part:IsA("BasePart") then
						part.AssemblyAngularVelocity = Vector3.zero
						if part.AssemblyLinearVelocity.Magnitude > 100 then
							part.AssemblyLinearVelocity = Vector3.zero
						end
					end
				end
			end
			for _, p in ipairs(P:GetPlayers()) do
				if p ~= LP and p.Character then
					for _, otherPart in ipairs(p.Character:GetDescendants()) do
						if otherPart:IsA("BasePart") then
							otherPart.CanCollide = false
						end
					end
				end
			end
		end)
	else StopT("AntiFling") end
end })

-- WALKSPEED BYPASS (CFRAME METHOD - WORKS ON ALL GAMES)
Tabs.Misc:AddToggle("EnableSpeed", { Title = "Enable Bypass WalkSpeed", Default = false, Callback = function(state)
	speedToggleEnabled = state
	if state then
		T.SpeedBypass = RS.Heartbeat:Connect(function(dt)
			local char = LP.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")

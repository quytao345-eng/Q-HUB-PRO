    -- SILENT AIM HOOK
    pcall(function()
        local rawMeta = getrawmetatable(game)
        local oldIndex = rawMeta.__index
        setreadonly(rawMeta, false)
        rawMeta.__index = newcclosure(function(self, key)
            if not checkcaller() and silentAimEnabled and self == Mouse then
                local targetPart, _ = GetClosestTargetToMouseFOV(aimFOV, aimWallCheck, aimTeamCheck, aimPart)
                if targetPart then
                    local k = key:lower()
                    if k == "hit" then return targetPart.CFrame
                    elseif k == "target" then return targetPart
                    elseif k == "x" then return Cam:WorldToViewportPoint(targetPart.Position).X
                    elseif k == "y" then return Cam:WorldToViewportPoint(targetPart.Position).Y
                    end
                end
            end
            return oldIndex(self, key)
        end)
        setreadonly(rawMeta, true)
    end)


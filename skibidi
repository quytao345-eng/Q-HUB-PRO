                    if espHealth then infoText = infoText .. "[" .. math.floor(math.max(0, hum.Health)) .. " HP] " end
                    if espDistance then
                        local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                        if myHrp then
                            local dist = math.floor((myHrp.Position - hrp.Position).Magnitude)
                            infoText = infoText .. "[" .. dist .. "m]"
                        end
                    end
                    txtLabel.Text = infoText
                end
            end
        end
    end)

    local function UpdateESPStates()
        for _, p in ipairs(P:GetPlayers()) do
            if p ~= LP and p.Character then
                local hl = p.Character:FindFirstChild("QHub_Highlight")
                if hl then hl.Enabled = espHighlight end
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                local bb = hrp and hrp:FindFirstChild("QHub_Billboard")
                if bb then bb.Enabled = (espName or espHealth or espDistance) end
                local boxBb = hrp and hrp:FindFirstChild("QHub_BoxGui")
                if boxBb then boxBb.Enabled = espBox end
            end
        end
    end

    Tabs.ESP:AddToggle("ESPHighlight", {Title = "ESP Highlight", Default = false}):OnChanged(function(v) espHighlight = v UpdateESPStates() end)
    Tabs.ESP:AddToggle("ESPBox", {Title = "ESP Box (Smooth)", Default = false}):OnChanged(function(v) espBox = v UpdateESPStates() end)
    Tabs.ESP:AddToggle("ESPName", {Title = "ESP Name", Default = false}):OnChanged(function(v) espName = v UpdateESPStates() end)
    Tabs.ESP:AddToggle("ESPHealth", {Title = "ESP Health", Default = false}):OnChanged(function(v) espHealth = v UpdateESPStates() end)
    Tabs.ESP:AddToggle("ESPDistance", {Title = "ESP Distance (m)", Default = false}):OnChanged(function(v) espDistance = v UpdateESPStates() end)

    -- FLY TOGGLE FUNCTION
    local function ToggleFly(state)
        if state == nil then state = not flyEnabled end
        flyEnabled = state
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if flyEnabled and hrp and hum then
            hum.PlatformStand = true

            local bg = Instance.new("BodyGyro")
            bg.Name = "QHub_FlyGyro"
            bg.P = 9e4
            bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
            bg.cframe = hrp.CFrame
            bg.Parent = hrp

            local bv = Instance.new("BodyVelocity")
            bv.Name = "QHub_FlyVel"
            bv.velocity = Vector3.zero
            bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
            bv.Parent = hrp

            T.Fly = RS.RenderStepped:Connect(function()
                if not flyEnabled or not hrp or not hrp.Parent then
                    StopT("Fly")
                    if bg then bg:Destroy() end
                    if bv then bv:Destroy() end
                    if hum then hum.PlatformStand = false end
                    return
                end

                bg.cframe = Cam.CFrame
                local moveVector = Vector3.zero
                local camCF = Cam.CFrame

                if UIS:IsKeyDown(Enum.KeyCode.W) then moveVector = moveVector + camCF.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.S) then moveVector = moveVector - camCF.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.A) then moveVector = moveVector - camCF.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.D) then moveVector = moveVector + camCF.RightVector end

                if moveVector.Magnitude > 0 then
                    bv.velocity = moveVector.Unit * flySpeed
                else
                    bv.velocity = Vector3.zero
                end
            end)
        else
            StopT("Fly")
            if hrp then
                local bg = hrp:FindFirstChild("QHub_FlyGyro")
                local bv = hrp:FindFirstChild("QHub_FlyVel")
                if bg then bg:Destroy() end
                if bv then bv:Destroy() end
            end
            if hum then hum.PlatformStand = false end
        end
    end

    local flyToggleUI = Tabs.Misc:AddToggle("FlyMode", { Title = "Fly (Shortcut: E)", Default = false, Callback = function(state)
        ToggleFly(state)
    end })

    -- HOTKEY LISTENER (ONLY E: Fly)
    UIS.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed or UIS:GetFocusedTextBox() then return end
        if input.KeyCode == Enum.KeyCode.E then
            flyToggleUI:SetValue(not flyEnabled)
        end
    end)

    Tabs.Misc:AddInput("InputFlySpeed", { Title = "Fly Speed", Default = "50", Numeric = true, Finished = true, Callback = function(txt) local num = tonumber(txt) if num then flySpeed = num end end })
    Tabs.Misc:AddToggle("EnableSpeed", { Title = "Smooth Speed", Default = false, Callback = function(state) speedToggleEnabled = state end })
    Tabs.Misc:AddInput("InputWalkSpeed", { Title = "Speed Value", Default = "50", Numeric = true, Finished = true, Callback = function(txt) local num = tonumber(txt) if num then walkSpeed = num end end })
    Tabs.Misc:AddInput("InputJumpPower", { Title = "Jump Power", Default = "50", Numeric = true, Finished = true, Callback = function(txt) local num = tonumber(txt) if num then jumpPower = num end end })
    Tabs.Misc:AddToggle("InfJump", { Title = "Infinite Jump", Default = false, Callback = function(state) infJumpEnabled = state end })

    UIS.JumpRequest:Connect(function()
        if infJumpEnabled and LP.Character then
            local hum = LP.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum:ChangeState("Jumping") end
        end
    end)

    Tabs.Misc:AddToggle("Noclip", { Title = "Noclip", Default = false, Callback = function(state)
        noclipEnabled = state
        if state then 
            T.Noclip = RS.Stepped:Connect(function() 
                if LP.Character and noclipEnabled then 
                    for _, part in ipairs(LP.Character:GetDescendants()) do 
                        if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end 
                    end 
                end 
            end) 
        else StopT("Noclip") end
    end })

    Tabs.Misc:AddButton({ Title = "Rejoin", Callback = function() game:GetService("TeleportService"):Teleport(game.PlaceId, LP) end })

    -- MAIN LOOP FOR SPEED AND POV TARGET MOVEMENT
    RS.Heartbeat:Connect(function(dt)
        local char = LP.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            
            if hum and hrp then
                hum.UseJumpPower = true
                hum.JumpPower = jumpPower

                -- POV TARGET LOGIC
                if povTargetEnabled and povTargetPosition then
                    local targetFlat = Vector3.new(povTargetPosition.X, hrp.Position.Y, povTargetPosition.Z)
                    local dir = targetFlat - hrp.Position
                    if dir.Magnitude > 1.5 then
                        hum:MoveTo(targetFlat)
                        hrp.CFrame = hrp.CFrame:Lerp(CFrame.new(hrp.Position, targetFlat), 0.25)
                        if speedToggleEnabled then
                            local moveDir = dir.Unit
                            hrp.CFrame = hrp.CFrame + (moveDir * walkSpeed * dt)
                        end
                    end
                elseif speedToggleEnabled and not flyEnabled then
                    if hum.MoveDirection.Magnitude > 0 then
                        local targetVelocity = hum.MoveDirection * walkSpeed
                        hrp.CFrame = hrp.CFrame + (targetVelocity * dt)
                        hrp.AssemblyLinearVelocity = Vector3.new(targetVelocity.X, hrp.AssemblyLinearVelocity.Y, targetVelocity.Z)
                    else
                        hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
                    end
                end
            end
        end
    end)

    Window:SelectTab(1)
end)


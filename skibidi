-- Q HUB - Rayfield UI Edition
local success, err = pcall(function()
    local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

    local Window = Rayfield:CreateWindow({
        Name = "⚡ Q HUB - Mobile Edition",
        LoadingTitle = "Q HUB Loading...",
        LoadingSubtitle = "by Gemini & Quy",
        ConfigurationSaving = {
            Enabled = false,
            FolderName = nil,
            FileName = "QHubConfig"
        },
        Discord = {
            Enabled = false,
            Invite = "noinvitelink",
            RememberJoins = true
        },
        KeySystem = false
    })

    -- SERVICES & VARIABLES
    local P, W, RS, UIS = game:GetService("Players"), game:GetService("Workspace"), game:GetService("RunService"), game:GetService("UserInputService")
    local LP = P.LocalPlayer
    local Cam = W.CurrentCamera
    local T = {}

    local walkSpeed, jumpPower, flySpeed = 50, 50, 50
    local speedToggleEnabled, infJumpEnabled, noclipEnabled, flyEnabled = false, false, false, false
    local behindDistance, targetBehindActive = 5, false
    local SelectedTargetPlayer = nil
    local touchToTargetEnabled = false
    local selectedTargetHighlight = nil

    local espHighlight = false
    local tpBlacklist = {}

    -- SHORTCUT BUTTONS (Q & NUM)
    local oldToggle = game:GetService("CoreGui"):FindFirstChild("QHubMobileToggle") or LP:WaitForChild("PlayerGui"):FindFirstChild("QHubMobileToggle")
    if oldToggle then oldToggle:Destroy() end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "QHubMobileToggle"
    ScreenGui.Parent = game:GetService("CoreGui") or LP:WaitForChild("PlayerGui")
    ScreenGui.ResetOnSpawn = false

    -- Nút Q (Mở/Ẩn UI)
    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Name = "ToggleBtn"
    ToggleBtn.Parent = ScreenGui
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    ToggleBtn.Position = UDim2.new(0.05, 0, 0.15, 0)
    ToggleBtn.Size = UDim2.new(0, 45, 0, 45)
    ToggleBtn.Font = Enum.Font.SourceSansBold
    ToggleBtn.Text = "Q"
    ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ToggleBtn.TextSize = 22
    ToggleBtn.Active = true
    ToggleBtn.Draggable = true
    Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(0.5, 0)

    -- Nút Num (Dịch chuyển ra sau lưng)
    local NumBtn = Instance.new("TextButton")
    NumBtn.Name = "NumBtn"
    NumBtn.Parent = ScreenGui
    NumBtn.BackgroundColor3 = Color3.fromRGB(180, 30, 30)
    NumBtn.Position = UDim2.new(0.05, 0, 0.23, 0)
    NumBtn.Size = UDim2.new(0, 45, 0, 45)
    NumBtn.Font = Enum.Font.SourceSansBold
    NumBtn.Text = "Num"
    NumBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    NumBtn.TextSize = 14
    NumBtn.Active = true
    NumBtn.Draggable = true
    Instance.new("UICorner", NumBtn).CornerRadius = UDim.new(0.5, 0)

    ToggleBtn.MouseButton1Click:Connect(function()
        Rayfield:Toggle()
    end)

    -- HELPER FUNCTIONS
    local function StopT(n)
        if T[n] then
            if typeof(T[n]) == "RBXScriptConnection" then T[n]:Disconnect() else task.cancel(T[n]) end
            T[n] = nil
        end
    end

    local function ResetCamToSelf()
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum and Cam then Cam.CameraSubject = hum end
    end

    local function HighlightTarget(plr)
        if selectedTargetHighlight then selectedTargetHighlight:Destroy() selectedTargetHighlight = nil end
        if plr and plr.Character then
            local hl = Instance.new("Highlight")
            hl.Name = "QHub_RedTargetHighlight"
            hl.FillColor = Color3.fromRGB(255, 0, 0)
            hl.FillTransparency = 0.3
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.Parent = plr.Character
            selectedTargetHighlight = hl
        end
    end

    local function GetNearestPlayer(maxDist)
        maxDist = maxDist or 500
        local closest, shortestDist = nil, maxDist
        local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if not myHrp then return nil end
        for _, p in ipairs(P:GetPlayers()) do
            if p ~= LP and p.Character then
                local pHrp, pHum = p.Character:FindFirstChild("HumanoidRootPart"), p.Character:FindFirstChildOfClass("Humanoid")
                if pHrp and pHum and pHum.Health > 0 then
                    local dist = (pHrp.Position - myHrp.Position).Magnitude
                    if dist < shortestDist then shortestDist, closest = dist, p end
                end
            end
        end
        return closest
    end

    local function GetPlayerListNames()
        local names = {}
        for _, p in ipairs(P:GetPlayers()) do
            if p ~= LP then table.insert(names, p.Name) end
        end
        return #names > 0 and names or {"Chua co nguoi choi"}
    end

    -- LOGIC TOUCH TO TARGET
    UIS.InputBegan:Connect(function(input, gpe)
        if gpe or not touchToTargetEnabled then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local pos = input.Position
            local unitRay = Cam:ViewportPointToRay(pos.X, pos.Y)
            local raycastParams = RaycastParams.new()
            raycastParams.FilterType = RaycastFilterType.Exclude
            if LP.Character then raycastParams.FilterDescendantsInstances = {LP.Character} end
            
            local res = W:Raycast(unitRay.Origin, unitRay.Direction * 1000, raycastParams)
            if res and res.Instance then
                local hitModel = res.Instance:FindFirstAncestorOfClass("Model")
                if hitModel then
                    local clickedPlr = P:GetPlayerFromCharacter(hitModel)
                    if clickedPlr and clickedPlr ~= LP then
                        SelectedTargetPlayer = clickedPlr
                        HighlightTarget(clickedPlr)
                    end
                end
            end
        end
    end)

    -- TABS
    local TargetTab = Window:CreateTab("Target", 4483345998)
    local TPTab = Window:CreateTab("TP All", 4483345998)
    local ESPTab = Window:CreateTab("ESP", 4483345998)
    local MiscTab = Window:CreateTab("Misc", 4483345998)

    -- TARGET TAB
    TargetTab:CreateToggle({
        Name = "Touch/Click Target (Do)",
        CurrentValue = false,
        Flag = "TouchTarget",
        Callback = function(Value)
            touchToTargetEnabled = Value
            if not Value and selectedTargetHighlight then
                selectedTargetHighlight:Destroy()
                selectedTargetHighlight = nil
            end
        end    
    })

    local function ToggleBehindTarget(enable)
        targetBehindActive = enable
        NumBtn.BackgroundColor3 = enable and Color3.fromRGB(30, 180, 30) or Color3.fromRGB(180, 30, 30)
        if targetBehindActive then
            if not SelectedTargetPlayer or not SelectedTargetPlayer.Character then 
                SelectedTargetPlayer = GetNearestPlayer(500) 
                HighlightTarget(SelectedTargetPlayer) 
            end
            T.Behind = RS.Heartbeat:Connect(function()
                local char = LP.Character local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local tPlr = SelectedTargetPlayer local tChar = tPlr and tPlr.Character local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart") local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
                if not tPlr or not tChar or not tHrp or not tHum or tHum.Health <= 0 then
                    ResetCamToSelf()
                    return
                end
                if hrp and tHrp then
                    hrp.CFrame = tHrp.CFrame * CFrame.new(0, 0, behindDistance)
                    hrp.AssemblyLinearVelocity = Vector3.zero
                end
            end)
        else
            StopT("Behind")
            ResetCamToSelf()
        end
    end

    TargetTab:CreateToggle({
        Name = "TP Sau Lung Target",
        CurrentValue = false,
        Flag = "TPBehind",
        Callback = function(Value) ToggleBehindTarget(Value) end    
    })

    NumBtn.MouseButton1Click:Connect(function()
        ToggleBehindTarget(not targetBehindActive)
    end)

    TargetTab:CreateInput({
        Name = "Khoang cach sau lung",
        PlaceholderText = "5",
        RemoveTextOnFocus = false,
        Callback = function(Value)
            local num = tonumber(Value)
            if num then behindDistance = num end
        end
    })

    TargetTab:CreateDropdown({
        Name = "Chon Nguoi Choi",
        Options = GetPlayerListNames(),
        CurrentOption = GetPlayerListNames()[1],
        Flag = "TargetDropdown",
        Callback = function(Value)
            local targetName = type(Value) == "table" and Value[1] or Value
            local foundPlr = P:FindFirstChild(targetName)
            if foundPlr then
                SelectedTargetPlayer = foundPlr
                HighlightTarget(foundPlr)
            end
        end
    })

    -- TP ALL TAB
    TPTab:CreateToggle({
        Name = "TP Lien Tuc Toan Bo Player",
        CurrentValue = false,
        Flag = "TPAll",
        Callback = function(Value)
            if Value then
                T.Teleport = task.spawn(function()
                    while true do
                        local alivePlayers = {}
                        for _, p in ipairs(P:GetPlayers()) do
                            if p ~= LP and not table.find(tpBlacklist, p.Name) and p.Character then
                                local tr = p.Character:FindFirstChild("HumanoidRootPart")
                                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                                if tr and hum and hum.Health > 0 then table.insert(alivePlayers, tr) end
                            end
                        end
                        local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                        if myHrp and #alivePlayers > 0 then
                            for _, targetHrp in ipairs(alivePlayers) do
                                if targetHrp and targetHrp.Parent then myHrp.CFrame = targetHrp.CFrame task.wait(0.0002) end
                            end
                        else task.wait(0.05) end
                    end
                end)
            else StopT("Teleport") end
        end
    })

    -- ESP TAB
    local function CreateESP(plr)
        if plr == LP then return end
        local function SetupCharacter(char)
            if not char then return end
            local hl = char:FindFirstChild("QHub_Highlight") or Instance.new("Highlight")
            hl.Name = "QHub_Highlight"
            hl.FillTransparency = 0.5
            hl.FillColor = Color3.fromRGB(255, 45, 85)
            hl.Enabled = espHighlight
            hl.Parent = char
        end
        if plr.Character then SetupCharacter(plr.Character) end
        plr.CharacterAdded:Connect(SetupCharacter)
    end
    for _, p in ipairs(P:GetPlayers()) do CreateESP(p) end
    P.PlayerAdded:Connect(CreateESP)

    ESPTab:CreateToggle({
        Name = "ESP Highlight Red",
        CurrentValue = false,
        Flag = "ESPRed",
        Callback = function(Value)
            espHighlight = Value
            for _, p in ipairs(P:GetPlayers()) do
                if p ~= LP and p.Character then
                    local hl = p.Character:FindFirstChild("QHub_Highlight")
                    if hl then hl.Enabled = Value end
                end
            end
        end
    })

    -- MISC TAB
    MiscTab:CreateToggle({
        Name = "Noclip (Xuyen tuong)",
        CurrentValue = false,
        Flag = "Noclip",
        Callback = function(Value)
            noclipEnabled = Value
            if Value then
                T.Noclip = RS.Stepped:Connect(function()
                    if LP.Character and noclipEnabled then
                        for _, part in ipairs(LP.Character:GetDescendants()) do
                            if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end
                        end
                    end
                end)
            else StopT("Noclip") end
        end
    })

    MiscTab:CreateButton({
        Name = "Vao lai game (Rejoin)",
        Callback = function() game:GetService("TeleportService"):Teleport(game.PlaceId, LP) end
    })

end)

if not success then warn("Loi Rayfield Q Hub: " .. tostring(err)) end

    local function RestoreGravity()
        -- Tắt Physics của mode Top → gravity bình thường
        pcall(function()
            local char = LP.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hum then
                hum.PlatformStand = false
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end
            if hrp then
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end
        end)
    end

    local function StopTargeting()
        pcall(function() RS:UnbindFromRenderStep("QHub_TargetFollow") end)
        if T.Behind then
            pcall(function()
                if typeof(T.Behind) == "RBXScriptConnection" then
                    T.Behind:Disconnect()
                elseif typeof(T.Behind) ~= "string" then
                    task.cancel(T.Behind)
                end
            end)
            T.Behind = nil
        end
        SelectedTargetPlayer = nil
        RestoreGravity()
        pcall(ResetCamToSelf)
    end

    local function StartTargetingPlayer(plr, forceEnable)
        if not plr or plr == LP then return end
        SelectedTargetPlayer = plr

        if forceEnable then
            targetModeEnabled = true
            SyncAllTargetUI(true)
        end
        if not targetModeEnabled then
            return
        end

        local TARGET_BIND = "QHub_TargetFollow"
        -- Unbind sạch trước khi bind lại (tránh stack → crash)
        pcall(function() RS:UnbindFromRenderStep(TARGET_BIND) end)
        if T.Behind then
            pcall(function()
                if typeof(T.Behind) == "RBXScriptConnection" then
                    T.Behind:Disconnect()
                end
            end)
            T.Behind = nil
        end

        local function stopFollowOnly()
            pcall(function() RS:UnbindFromRenderStep(TARGET_BIND) end)
            if T.Behind then
                pcall(function()
                    if typeof(T.Behind) == "RBXScriptConnection" then T.Behind:Disconnect() end
                end)
                T.Behind = nil
            end
        end

        local function followStep(dt)
            if not targetModeEnabled then
                stopFollowOnly()
                return
            end
            local char = LP.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local tPlr = SelectedTargetPlayer
            if not tPlr or not tPlr.Parent then
                targetModeEnabled = false
                stopFollowOnly()
                SelectedTargetPlayer = nil
                task.defer(function() SyncAllTargetUI(false) end)
                return
            end
            local tChar = tPlr.Character
            local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
            local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
            if not tHrp or not tHum or tHum.Health <= 0 then
                targetModeEnabled = false
                stopFollowOnly()
                SelectedTargetPlayer = nil
                task.defer(function() SyncAllTargetUI(false) end)
                return
            end
            if not hrp then return end

            local dist = math.max(0, behindDistance or 6)
            local mode = targetPositionMode or "Top"
            local myHum = char:FindFirstChildOfClass("Humanoid")

            if mode == "Top" then
                -- Cố định trên đầu target, không rơi (set cứng + zero velocity)
                local topPos = tHrp.Position + Vector3.new(0, dist, 0)
                local goalCF = CFrame.new(topPos, tHrp.Position)
                hrp.CFrame = goalCF
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
                if myHum then
                    pcall(function()
                        myHum:ChangeState(Enum.HumanoidStateType.Physics)
                    end)
                end
            else
                local goalCF
                if mode == "Behind" then
                    goalCF = tHrp.CFrame * CFrame.new(0, 0, dist)
                else -- Front
                    local front = tHrp.CFrame * CFrame.new(0, 0, -dist)
                    goalCF = CFrame.new(front.Position, tHrp.Position)
                end
                local alpha = math.clamp((targetSmooth or 0.35), 0.1, 1)
                hrp.CFrame = hrp.CFrame:Lerp(goalCF, alpha)
                local vel = hrp.AssemblyLinearVelocity
                hrp.AssemblyLinearVelocity = Vector3.new(vel.X * 0.2, 0, vel.Z * 0.2)
            end
        end

        local bindOk = pcall(function()
            RS:BindToRenderStep(TARGET_BIND, Enum.RenderPriority.Camera.Value + 1, followStep)
        end)
        if not bindOk then
            -- Fallback Heartbeat nếu BindToRenderStep fail
            T.Behind = RS.Heartbeat:Connect(function(dt)
                pcall(followStep, dt)
            end)
        else
            T.Behind = TARGET_BIND -- marker
        end
    end

    local syncingMode = false

                if hl then hl.Enabled = v end
            end
        end
    end})

    -- MISC
    local function ToggleFly(state)
        if state == nil then state = not flyEnabled end
        flyEnabled = state
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if flyEnabled and hrp and hum then
            hum.PlatformStand = true
            local bg = Instance.new("BodyGyro")
            bg.Name = "QHubFlyGyro"
            bg.P = 9e4
            bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
            bg.CFrame = hrp.CFrame
            bg.Parent = hrp
            local bv = Instance.new("BodyVelocity")
            bv.Name = "QHubFlyVel"
            bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bv.Velocity = Vector3.zero
            bv.Parent = hrp
            T.Fly = RS.RenderStepped:Connect(function()
                if not flyEnabled or not hrp.Parent then
                    StopT("Fly")
                    if bg then bg:Destroy() end
                    if bv then bv:Destroy() end
                    if hum then hum.PlatformStand = false end
                    return
                end
                bg.CFrame = Cam.CFrame
                local move = Vector3.zero
                if UIS:IsKeyDown(Enum.KeyCode.W) then move += Cam.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.S) then move -= Cam.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.A) then move -= Cam.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.D) then move += Cam.CFrame.RightVector end
                bv.Velocity = move.Magnitude > 0 and move.Unit * flySpeed or Vector3.zero
            end)
        else
            StopT("Fly")
            if hrp then
                local bg = hrp:FindFirstChild("QHubFlyGyro")
                local bv = hrp:FindFirstChild("QHubFlyVel")
                if bg then bg:Destroy() end
                if bv then bv:Destroy() end
            end
            if hum then hum.PlatformStand = false end
        end
    end


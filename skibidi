                        table.insert(lines, math.floor((myHrp.Position - hrp.Position).Magnitude) .. "m")
                    end
                    data.nameLbl.Text = table.concat(lines, "\n")
                end

                -- Tracer dây từ đáy màn hình → chân player
                if data.tracer and espTracer then
                    local pos, onScreen = Cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                    if onScreen and pos.Z > 0 then
                        pcall(function()
                            data.tracer.From = fromPos
                            data.tracer.To = Vector2.new(pos.X, pos.Y)
                            data.tracer.Visible = true
                        end)
                    else
                        pcall(function() data.tracer.Visible = false end)
                    end
                elseif data.tracer then
                    pcall(function() data.tracer.Visible = false end)
                end
            else
                if data.tracer then pcall(function() data.tracer.Visible = false end) end
            end
        end
    end)


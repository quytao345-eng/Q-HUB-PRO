    local function UpdateBehindDistance(val, fromMobile)
        local num = tonumber(val)
        if not (num and num >= 0) then
            if NumTargetBox then NumTargetBox.Text = tostring(behindDistance) end
            return
        end
        behindDistance = num
        syncingNum = true
        if NumTargetBox and NumTargetBox.Text ~= tostring(num) then
            NumTargetBox.Text = tostring(num)
        end
        if not fromMobile and BehindDistInputObj and BehindDistInputObj.Set then
            pcall(function() BehindDistInputObj:Set(tostring(num)) end)
        end
        if fromMobile and BehindDistInputObj and BehindDistInputObj.Set then
            pcall(function() BehindDistInputObj:Set(tostring(num)) end)
        end
        syncingNum = false
    end

    NumTargetBox.FocusLost:Connect(function()
        UpdateBehindDistance(NumTargetBox.Text, true)
    end)
    NumTargetBox:GetPropertyChangedSignal("Text"):Connect(function()
        if syncingNum then return end
        local num = tonumber(NumTargetBox.Text)
        if num and num >= 0 then
            behindDistance = num
            if BehindDistInputObj and BehindDistInputObj.Set then

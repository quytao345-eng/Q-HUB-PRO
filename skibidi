    local function UpdateESPStates()
        for plr, data in pairs(ESPData) do
            if data.hl then data.hl.Enabled = espHighlight end
            if data.bb then data.bb.Enabled = (espName or espDistance) end
            if data.boxBb then data.boxBb.Enabled = espBox end
            if data.hpBb then data.hpBb.Enabled = espHealth end
            if data.tracerLine and not espTracer then
                data.tracerLine.Visible = false
            end
        end
        if TracerGui then TracerGui.Enabled = true end
    end

    local function UpdateTracerLine(frame, from, to)
        local dx = to.X - from.X
        local dy = to.Y - from.Y
        local len = math.sqrt(dx * dx + dy * dy)
        if len < 1 then
            frame.Visible = false
            return
        end
        local midX = (from.X + to.X) / 2
        local midY = (from.Y + to.Y) / 2
        local angle = math.deg(math.atan2(dy, dx))
        frame.Position = UDim2.fromOffset(midX, midY)
        frame.Size = UDim2.fromOffset(len, 1) -- mỏng 1px
        frame.Rotation = angle
        frame.Visible = true
    end

    RS.RenderStepped:Connect(function()
        local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local viewport = Cam.ViewportSize
        -- Dây từ trên cùng màn hình
        local fromPos = Vector2.new(viewport.X / 2, 2)

        for plr, data in pairs(ESPData) do
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            -- Team check: ẩn teammate
            local isTeammate = espTeamCheck and plr.Team ~= nil and LP.Team ~= nil and plr.Team == LP.Team
            if isTeammate then
                if data.hl then data.hl.Enabled = false end
                if data.bb then data.bb.Enabled = false end
                if data.boxBb then data.boxBb.Enabled = false end
                if data.hpBb then data.hpBb.Enabled = false end
                if data.tracerLine then data.tracerLine.Visible = false end
            elseif hrp and hum and hum.Health > 0 then
                if data.hl then data.hl.Enabled = espHighlight end
                if data.bb then data.bb.Enabled = (espName or espDistance) end
                if data.boxBb then data.boxBb.Enabled = espBox end
                if data.hpBb then data.hpBb.Enabled = espHealth end

                if data.nameLbl and data.bb and data.bb.Enabled then
                    local lines = {}
                    if espName then table.insert(lines, plr.Name) end
                    if espDistance and myHrp then
                        table.insert(lines, math.floor((myHrp.Position - hrp.Position).Magnitude) .. "m")
                    end
                    data.nameLbl.Text = table.concat(lines, "\n")
                end

                if data.tracerLine then
                    if espTracer then
                        local pos, onScreen = Cam:WorldToViewportPoint(hrp.Position)
                        if onScreen and pos.Z > 0 then
                            UpdateTracerLine(data.tracerLine, fromPos, Vector2.new(pos.X, pos.Y))
                        else
                            data.tracerLine.Visible = false
                        end
                    else
                        data.tracerLine.Visible = false
                    end
                end
            else
                if data.tracerLine then data.tracerLine.Visible = false end
            end
        end
    end)


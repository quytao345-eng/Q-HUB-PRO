    local function IsVisiblePart(targetPart, wallCheckEnabled)
        if not wallCheckEnabled or not targetPart then return true end
        local myChar = LP.Character
        if not myChar then return false end
        local origin = Cam.CFrame.Position
        local dir = (targetPart.Position - origin)
        if dir.Magnitude < 1 then return true end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { myChar, targetPart.Parent }
        local result = W:Raycast(origin, dir.Unit * math.min(dir.Magnitude, 500), params)
        return result == nil or (result.Instance and result.Instance:IsDescendantOf(targetPart.Parent))
    end

    local function GetMouseScreenPos()
        -- Vị trí chuột chính xác trên màn hình (FOV Target)
        local ok, pos = pcall(function() return UIS:GetMouseLocation() end)
        if ok and pos then return pos end
        return Vector2.new(Mouse.X, Mouse.Y)
    end

    local function GetClosestTargetToMouseFOV(radius, wallCheck, teamCheck, specificPart, centerPos)
        local closestPart, closestPlayer, shortestDistance = nil, nil, radius
        -- centerPos: nil = theo chuột (Target) · có thì dùng (Aim = giữa màn hình)
        local fovCenterPos = centerPos or GetMouseScreenPos()

        for _, p in ipairs(P:GetPlayers()) do
            if p ~= LP and p.Character and not (teamCheck and p.Team == LP.Team) then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local part = specificPart and (p.Character:FindFirstChild(specificPart) or p.Character:FindFirstChild("HumanoidRootPart")) or p.Character:FindFirstChild("HumanoidRootPart")
                    if part then
                        local screenPos, onScreen = Cam:WorldToViewportPoint(part.Position)
                        if onScreen then
                            local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - fovCenterPos).Magnitude
                            if distFromCenter < shortestDistance and IsVisiblePart(part, wallCheck) then
                                shortestDistance = distFromCenter
                                closestPart, closestPlayer = part, p
                            end
                        end
                    end
                end
            end
        end
        return closestPart, closestPlayer
    end

    local function GetScreenCenter()
        local vs = Cam.ViewportSize
        return Vector2.new(vs.X / 2, vs.Y / 2)
    end

    local function ToggleTargetMode(state)
        local now = tick()
        if now - lastTargetToggleAt < 0.25 then return end
        lastTargetToggleAt = now

        if state == nil then state = not targetModeEnabled end

        if not state then
            targetModeEnabled = false
            StopTargeting()
            SyncAllTargetUI(false)
            return
        end

        targetModeEnabled = true
        SyncAllTargetUI(true)

        local okPick, targetPlr = pcall(function()
            if SelectedTargetPlayer and SelectedTargetPlayer.Parent then
                return SelectedTargetPlayer
            end
            local _, plr = GetClosestTargetToMouseFOV(targetFOVRadius, targetWallCheck)
            return plr
        end)

        if okPick and targetPlr then
            pcall(StartTargetingPlayer, targetPlr)
        else
            pcall(function()
                WindUI:Notify({ Title = "Target", Content = "Chưa có target · click gần người chơi", Duration = 2 })
            end)
        end
    end


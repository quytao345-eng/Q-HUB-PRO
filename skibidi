                vu:Button2Up(Vector2.new(0, 0), Cam.CFrame)
            end)
        elseif antiAfkConn then
            antiAfkConn:Disconnect()
            antiAfkConn = nil
        end
    end
})

-- 5. SERVER HOP (SEARCH LOW PLAYER SERVER)
Tabs.Boost:AddButton({
    Title = "Server Hop (Low Players)",
    Callback = function()
        task.spawn(function()
            local placeId = game.PlaceId
            local reqUrl = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
            local success, result = pcall(function()
                return HttpService:JSONDecode(game:HttpGet(reqUrl))
            end)
            if success and result and result.data then
                for _, server in ipairs(result.data) do
                    if server.playing < server.maxPlayers and server.id ~= game.JobId then
                        TPS:TeleportToPlaceInstance(placeId, server.id, LP)
                        break
                    end
                end
            else
                TPS:Teleport(placeId, LP)
            end
        end)
    end
})


    UIS.InputBegan:Connect(function(input, gameProcessed)
        -- Rebind hotkey mode (ưu tiên cao nhất)
        if waitingForKeybind and input.UserInputType == Enum.UserInputType.Keyboard then
            local key = input.KeyCode
            if key == Enum.KeyCode.Unknown or key == Enum.KeyCode.Escape then
                waitingForKeybind = nil
                if tpAllKeybindBtn and tpAllKeybindBtn.SetTitle then
                    pcall(function() tpAllKeybindBtn:SetTitle("TP All Hotkey: [" .. KeyCodeToName(tpAllKeybind) .. "]") end)
                end
                if targetKeybindBtn and targetKeybindBtn.SetTitle then
                    pcall(function() targetKeybindBtn:SetTitle("Target Hotkey: [" .. KeyCodeToName(targetKeybind) .. "]") end)
                end
                if flyKeybindBtn and flyKeybindBtn.SetTitle then
                    pcall(function() flyKeybindBtn:SetTitle("Fly Hotkey: [" .. KeyCodeToName(flyKeybind) .. "]") end)
                end
                return
            end

            local name = key.Name
            if waitingForKeybind == "tpall" then
                tpAllKeybind = key
                if tpAllKeybindBtn and tpAllKeybindBtn.SetTitle then
                    pcall(function() tpAllKeybindBtn:SetTitle("TP All Hotkey: [" .. name .. "]") end)
                end
                WindUI:Notify({ Title = "Q HUB", Content = "TP All → [" .. name .. "]", Duration = 2 })
            elseif waitingForKeybind == "target" then
                targetKeybind = key
                if targetKeybindBtn and targetKeybindBtn.SetTitle then
                    pcall(function() targetKeybindBtn:SetTitle("Target Hotkey: [" .. name .. "]") end)
                end
                WindUI:Notify({ Title = "Q HUB", Content = "Target → [" .. name .. "]", Duration = 2 })
            elseif waitingForKeybind == "fly" then
                flyKeybind = key
                if flyKeybindBtn and flyKeybindBtn.SetTitle then
                    pcall(function() flyKeybindBtn:SetTitle("Fly Hotkey: [" .. name .. "]") end)
                end
                WindUI:Notify({ Title = "Q HUB", Content = "Fly → [" .. name .. "]", Duration = 2 })
            end
            waitingForKeybind = nil
            return
        end

        -- Target mode click-to-select
        if gameProcessed or not targetModeEnabled then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if not SelectedTargetPlayer then
                local _, targetPlr = GetClosestTargetToMouseFOV(targetFOVRadius, targetWallCheck)
                if targetPlr then
                    StartTargetingPlayer(targetPlr)
                end
            end
        end
    end)

    local function GetPlayerListNames()
        local names = {}

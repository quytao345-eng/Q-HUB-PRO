    local fixLag40Enabled = false
    local fixLag40Conn = nil
    local fixLag40Queue = {}
    local fixLag40Queued = {}
    local fixLag40BatchRunning = false
    local FIX40_BATCH = 35

    local function NeedsFixLag40(v)
        return v:IsA("BasePart")
            or v:IsA("SpecialMesh")
            or v:IsA("Texture") or v:IsA("Decal")
            or v:IsA("SurfaceAppearance")
            or v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam")
            or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles")
    end

    local function ApplyFixLag40To(v)
        if not v or not v.Parent then return end
        pcall(function()
            if v:IsA("BasePart") then
                v.CastShadow = false
                v.Reflectance = 0
                if v.Material ~= Enum.Material.ForceField then
                    v.Material = Enum.Material.SmoothPlastic
                end
                if v:IsA("MeshPart") then
                    pcall(function()
                        v.RenderFidelity = Enum.RenderFidelity.Performance
                    end)
                end
            elseif v:IsA("SpecialMesh") then
                if v.TextureId ~= "" then v.TextureId = "" end
            elseif v:IsA("Texture") or v:IsA("Decal") then
                v.Transparency = 1
            elseif v:IsA("SurfaceAppearance") then
                v:Destroy()
            elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam")
                or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
                v.Enabled = false
            end
        end)
    end

    local function EnqueueFix40(v)
        if not fixLag40Enabled or not v or fixLag40Queued[v] then return end
        if not NeedsFixLag40(v) then return end
        fixLag40Queued[v] = true
        fixLag40Queue[#fixLag40Queue + 1] = v
    end

    local function ProcessFix40Batch()
        if fixLag40BatchRunning or not fixLag40Enabled then return end
        fixLag40BatchRunning = true
        task.spawn(function()
            while fixLag40Enabled and #fixLag40Queue > 0 do
                local n = 0
                while n < FIX40_BATCH and #fixLag40Queue > 0 do
                    local v = table.remove(fixLag40Queue, 1)
                    if v then
                        fixLag40Queued[v] = nil
                        ApplyFixLag40To(v)
                    end
                    n = n + 1
                end
                task.wait()
            end
            fixLag40BatchRunning = false
        end)
    end

    local function ApplyFixLag40AllBatched()
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        for _, v in ipairs(W:GetDescendants()) do
            EnqueueFix40(v)
        end
        ProcessFix40Batch()
    end


    RS.RenderStepped:Connect(function()
        local fovPos = Vector2.new(Mouse.X, Mouse.Y + fixedPovOffset)

        if showFOVCircle then
            if FOVCircle then
                FOVCircle.Position, FOVCircle.Radius, FOVCircle.Visible = fovPos, aimFOV, true
            elseif GuiCircle then
                GuiCircle.Position = UDim2.new(0, fovPos.X, 0, fovPos.Y)
                GuiCircle.Size = UDim2.new(0, aimFOV * 2, 0, aimFOV * 2)
                GuiCircle.Visible = true
            end
        else
            if FOVCircle then FOVCircle.Visible = false end
            if GuiCircle then GuiCircle.Visible = false end
        end

        if showTargetFOVCircle then
            if TargetFOVCircle then
                TargetFOVCircle.Position, TargetFOVCircle.Radius, TargetFOVCircle.Visible = fovPos, targetFOVRadius, true
            elseif TargetGuiCircle then
                TargetGuiCircle.Position = UDim2.new(0, fovPos.X, 0, fovPos.Y)
                TargetGuiCircle.Size = UDim2.new(0, targetFOVRadius * 2, 0, targetFOVRadius * 2)
                TargetGuiCircle.Visible = true
            end
        else
            if TargetFOVCircle then TargetFOVCircle.Visible = false end
            if TargetGuiCircle then TargetGuiCircle.Visible = false end
        end

        if aimLockEnabled then
            local target, _ = GetClosestTargetToMouseFOV(aimFOV, aimWallCheck, aimTeamCheck, aimPart)
            if target then Cam.CFrame = Cam.CFrame:Lerp(CFrame.new(Cam.CFrame.Position, target.Position), aimSmoothness) end
        end
    end)

